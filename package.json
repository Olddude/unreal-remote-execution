{
  "name": "@olddude/unreal-remote-execution",
  "version": "1.0.0",
  "description": "Application to connect to a Unreal Engine instance and execute python commands",
  "private": true,
  "engineStrict": true,
  "author": {
    "name": "Anonymous Universus"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olddude/unreal-remote-execution"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . -c eslint.config.mjs --ignore-pattern publish",
    "lint:fix": "npm run lint -- --fix",
    "test:ci": "jest --coverage",
    "test": "npm run test:ci -- --watch",
    "build": "node -r dotenv/config esbuild.config.mjs",
    "start:debug": "node -r dotenv/config -r ts-node/register index.ts",
    "start:release": "node -r dotenv/config publish/index.js",
    "start": "nodemon"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "eslint": "^8.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.31.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "express": "^5.1.0"
  }
}
